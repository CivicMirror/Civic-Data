{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CivicMirror/Civic-Data/schemas/jurisdiction.schema.json",
  "title": "Jurisdiction",
  "description": "A governing authority within a geographic division.",
  "type": "object",
  "required": ["id", "name", "state", "division_id", "classification", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "OCD jurisdiction ID: the division path plus a governance classification.",
      "pattern": "^ocd-jurisdiction/country:us(/[a-z_]+:[a-z0-9~_.-]+)+/[a-z][a-z0-9_]*$"
    },
    "name": { "type": "string", "minLength": 1 },
    "state": { "type": "string", "pattern": "^[a-z]{2}$" },
    "division_id": {
      "type": "string",
      "description": "The geographic OCD division governed by this jurisdiction.",
      "pattern": "^ocd-division/country:us(/[a-z_]+:[a-z0-9~_.-]+)+$"
    },
    "classification": {
      "type": "string",
      "enum": ["government", "legislature", "executive", "school", "park", "sewer", "forest", "transit_authority"]
    },
    "government_form": {
      "type": "string",
      "description": "e.g. 'mayor-council', 'council-manager', 'open town meeting', 'representative town meeting', 'select board'"
    },
    "website": { "type": "string", "format": "uri" },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "identifier.schema.json" },
      "description": "Crosswalk to this jurisdiction as identified in an external dataset, e.g. {\"scheme\": \"civicpatch\", \"identifier\": \"ocd-jurisdiction/country:us/state:ma/county:bristol/place:norton/government\"} for CivicPatch/open-data, whose jurisdiction ids include a county segment this repo's id does not."
    },
    "site_intelligence": {
      "type": "object",
      "description": "Shared scraper/pipeline intel about how this jurisdiction publishes data.",
      "additionalProperties": false,
      "properties": {
        "cms_platform": { "type": "string", "description": "e.g. 'CivicPlus', 'Granicus', 'Neapolitan Labs', 'Drupal', 'custom'" },
        "officials_directory_url": { "type": "string", "format": "uri" },
        "election_results_url": { "type": "string", "format": "uri" },
        "election_results_vendor": { "type": "string", "description": "e.g. 'Clarity', 'TotalVote', 'PCC', 'state ElectionStats', 'PDF only'" },
        "notes": { "type": "string" }
      }
    },
    "election_authority": {
      "type": "object",
      "description": "Who administers this jurisdiction's elections.",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "string", "enum": ["municipal", "county", "state"] },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "note": { "type": "string" },
          "retrieved": { "type": "string", "format": "date" }
        }
      }
    }
  }
}
