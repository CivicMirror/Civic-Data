{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CivicMirror/Civic-Data/schemas/election.schema.json",
  "title": "Election",
  "description": "A reviewable election identity containing one or more contests.",
  "type": "object",
  "required": ["id", "name", "date", "election_type", "status", "contests", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+/\\d{4}-\\d{2}-\\d{2}/[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "election_type": {"type": "string", "enum": ["general", "special", "primary", "runoff", "recall", "town-meeting"]},
    "status": {"type": "string", "enum": ["scheduled", "unofficial", "official", "certified", "corrected"]},
    "contests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contest"}},
    "sources": {"$ref": "#/$defs/sources"}
  },
  "$defs": {
    "contest": {
      "type": "object", "required": ["id", "jurisdiction_id", "office_id", "vote_for", "candidate_ids", "result_status", "winners"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "jurisdiction_id": {"type": "string", "pattern": "^ocd-division/country:us(/[a-z_]+:[a-z0-9~_.-]+)+$"},
        "office_id": {"type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"},
        "party": {"type": ["string", "null"]},
        "seat": {"type": "string"},
        "vote_for": {"type": "integer", "minimum": 1},
        "candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ocd-person/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}},
        "result_status": {"type": "string", "enum": ["pending", "unofficial", "official", "certified", "corrected"]},
        "winners": {"type": ["array", "null"], "items": {"$ref": "#/$defs/winner"}}
      }
    },
    "winner": {
      "type": "object", "required": ["person_id", "name"], "additionalProperties": false,
      "properties": {
        "person_id": {"type": "string", "pattern": "^ocd-person/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
        "name": {"type": "string", "minLength": 1}, "votes": {"type": "integer", "minimum": 0}, "party": {"type": "string"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["url"], "additionalProperties": false, "properties": {"url": {"type": "string", "format": "uri"}, "note": {"type": "string"}, "retrieved": {"type": "string", "format": "date"}}}
    }
  }
}
