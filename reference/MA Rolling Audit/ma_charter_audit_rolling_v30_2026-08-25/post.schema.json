{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CivicMirror/Civic-Data/schemas/post.schema.json",
  "title": "Post",
  "description": "A position that exists independently of the person who holds it.",
  "type": "object",
  "required": [
    "id",
    "organization_id",
    "title",
    "seats",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "organization_id": {
      "type": "string",
      "pattern": "^ocd-organization/[0-9a-f-]{36}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "seats": {
      "type": "integer",
      "minimum": 1
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "identifier.schema.json"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "note": {
            "type": "string"
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
