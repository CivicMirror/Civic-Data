{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CivicMirror/Civic-Data/schemas/organization.schema.json",
  "title": "Organization",
  "description": "A concrete government body operating within a jurisdiction.",
  "type": "object",
  "required": ["id", "name", "jurisdiction_id", "identifiers", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^ocd-organization/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "name": { "type": "string", "minLength": 1 },
    "jurisdiction_id": { "type": "string", "pattern": "^ocd-jurisdiction/country:us(/[a-z_]+:[a-z0-9~_.-]+)+/[a-z][a-z0-9_]*$" },
    "identifiers": { "type": "array", "uniqueItems": true, "items": { "$ref": "identifier.schema.json" } },
    "status": { "type": "string", "enum": ["active", "inactive", "historical"] },
    "notes": { "type": "string" },
    "sources": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["url"], "additionalProperties": false, "properties": { "url": { "type": "string", "format": "uri" }, "note": { "type": "string" }, "retrieved": { "type": "string", "format": "date" } } } }
  }
}
